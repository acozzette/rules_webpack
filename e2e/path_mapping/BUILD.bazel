load("@aspect_rules_webpack//webpack:defs.bzl", "webpack_bundle")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

webpack_bundle(
    name = "bundle",
    configure_devtool = False,
    # configure_mode/configure_devtool bake the Bazel compilation mode into the action's
    # environment, which would legitimately differ between -c fastbuild and -c opt and defeat
    # the point of this test. See test.sh for why use_execroot_entry_point is also disabled.
    configure_mode = False,
    entry_point = "module.js",
    node_modules = "//:node_modules",
    use_execroot_entry_point = False,
)

# Gives the `bazel test //...` step in CI something to run; the actual path mapping /
# disk cache assertion lives in test.sh, which is run as a separate CI step.
build_test(
    name = "bundle_test",
    targets = [":bundle"],
)
